DATABASE_URL=postgresql://postgres:postgres@localhost:5432/jippronex
PORT=4000
JWT_SECRET=change-me-long-random-string
# Comma separated origins allowed to call the API (CRM + Admin web URLs)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
# Public URLs (used in links sent on WhatsApp / SMS)
CRM_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
# Dev: OTP is returned in the API response + printed in logs. Set to "false" in production.
OTP_DEV_MODE=true
# SMS / WhatsApp provider (optional). msg91 | none
SMS_PROVIDER=none
MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=
# First super admin (created by seed / on boot if no admin exists)
ADMIN_EMAIL=admin@jippronex.com
ADMIN_PASSWORD=Admin@123
