{
  "expo": {
    "name": "Jippronex",
    "slug": "jippronex",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jippronex.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B46C4",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.jippronex.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Jippronex to use the camera to scan product barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-secure-store",
      "expo-sharing",
      "expo-web-browser",
      "expo-font"
    ],
    "scheme": "jippronex",
    "primaryColor": "#0B46C4",
    "extra": {
      "apiUrl": "https://api-production-6c83491d.up.railway.app",
      "eas": {}
    }
  }
}
